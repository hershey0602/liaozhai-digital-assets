/**app.wxss**/
/* 聊斋志异小程序全局样式文件 */
/* 定义整个小程序的基础样式和通用类 */

/* 页面容器基础样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  line-height: 1.6;
}

/* 通用容器类 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 卡片样式 - 用于内容展示 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

/* 主标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

/* 副标题样式 */
.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* 正文文字样式 */
.text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

/* 主要按钮样式 - 深色主题 */
.btn-primary {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

/* 按钮点击效果 */
.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 次要按钮样式 */
.btn-secondary {
  background: #fff;
  color: #1a1a2e;
  border: 2rpx solid #1a1a2e;
  border-radius: 12rpx;
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 按钮点击效果 */
.btn-secondary:active {
  background: #f5f5f5;
}

/* 禁用按钮样式 */
.btn-disabled {
  background: #ccc;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: #e0e0e0;
  margin: 20rpx 0;
}

/* 弹性布局工具类 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

/* 文字对齐 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

/* 聊斋主题色 */
.theme-color {
  color: #1a1a2e;
}

.theme-bg {
  background-color: #1a1a2e;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
